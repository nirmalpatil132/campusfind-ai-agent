# ---------- apps/api/.env ----------
APP_ENV=development
COLLEGE_NAME="Government College of Engineering, Kolhapur"

# Agent mode: auto (Ollama if running, else rules) | ollama | rules
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# Optional embeddings via Ollama (ollama | none). Matching still works without them.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Phase 1 hello_agent.py only (paid credits; NOT needed by the agent)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Unused in the no-paid-API build
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=                     # Supabase connection string (use the pooler string if direct fails)
SUPABASE_URL=                     # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=         # sb_publishable_... (public; the web page uses it to log in)
SUPABASE_SECRET_KEY=              # sb_secret_... (server only, only if ever needed)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
AGENT_MAX_STEPS=6
CHAT_HISTORY_LIMIT=20

# ---------- apps/web/.env.local (Phase 6 Next.js, not used yet) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (safe for browser)
